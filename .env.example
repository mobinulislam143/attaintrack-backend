# ─────────────────────────────────────────────────────────────────────────────
# Backend environment.
#
# Copy to `.env` for local development. On Vercel, set the same keys under
# Project → Settings → Environment Variables (Production + Preview).
#
# The three marked REQUIRED are asserted at startup — the process exits if any
# is missing, rather than failing later on the first request.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (REQUIRED) ──────────────────────────────────────────────────────
# MongoDB connection string, including the database name.
DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster.mongodb.net/obedb"

# ── JWT (REQUIRED) ───────────────────────────────────────────────────────────
# Two different long random strings. Rotating them invalidates every session.
JWT_ACCESS_SECRET="change-me-to-a-long-random-string"
JWT_REFRESH_SECRET="change-me-to-a-different-long-random-string"
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ── Server ───────────────────────────────────────────────────────────────────
# PORT is ignored on Vercel, which supplies its own.
PORT=5021
NODE_ENV=development

# The frontend origin, used for the CORS allowlist and for the links in
# verification and password-reset emails. In production this must be the
# deployed frontend URL, with no trailing slash.
FRONTEND_URL=http://localhost:3000

# ── SMTP ─────────────────────────────────────────────────────────────────────
# Optional. Without these, registration and password reset still work — only
# the emails are skipped, and a warning is logged.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your-app-password
SMTP_FROM="OBE Attainment System <you@example.com>"

# ── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=2000

# ── Seed accounts ────────────────────────────────────────────────────────────
# Used only by `npx ts-node prisma/seed.ts`. Change these before seeding a
# production database.
ADMIN_EMAIL="admin@obe.edu"
ADMIN_PASSWORD="Admin@1234"
TEACHER_EMAIL="teacher@obe.edu"
TEACHER_PASSWORD="Teacher@1234"
STUDENT_EMAIL="student@obe.edu"
STUDENT_PASSWORD="Student@1234"

# Set to false to seed permissions, roles and accounts only, without the
# demonstration department, courses, students and marks.
SEED_DEMO=true

# ── Diagnostics ──────────────────────────────────────────────────────────────
# Prisma query logging is off by default — a single page load issues dozens of
# queries and the noise buries the request log.
PRISMA_LOG_QUERIES=false
